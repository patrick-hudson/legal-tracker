# Server Configuration
PORT=3000
HOST=0.0.0.0

# Authentication
# Set to 'true' to require IP whitelist or API key for write operations
REQUIRE_AUTH=true

# Comma-separated list of allowed IP addresses for write operations
# Find your IP at: https://whatismyipaddress.com/
ALLOWED_IPS=123.45.67.89,98.76.54.32

# Optional API key for programmatic access (can be used instead of IP whitelist)
# Generate one with: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# CORS origin (set to your domain in production, or 'true' to allow all)
CORS_ORIGIN=true
