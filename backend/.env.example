# Legal Tracker Backend Configuration

# Server Port
PORT=3000

# Server Host (defaults to 0.0.0.0)
HOST=0.0.0.0

# CORS Origin (comma-separated, or * for all)
CORS_ORIGIN=*

# Authentication Settings
REQUIRE_AUTH=false
API_KEY=
ALLOWED_IPS=

# Admin Portal Authentication
# JWT Secret - CHANGE THIS IN PRODUCTION (generate with: openssl rand -base64 32)
JWT_SECRET=change-this-secret-in-production

# Password Salt for client-side hashing - CHANGE THIS IN PRODUCTION (generate with: openssl rand -hex 32)
PASSWORD_SALT=legal-tracker-default-CHANGE-THIS

# JWT Expiration
JWT_EXPIRY=7d

# Cookie Security (set to 'true' in production with HTTPS)
COOKIE_SECURE=false

# Environment
NODE_ENV=development

# Data Management Safety Flags (production only)
# Set to 'true' to enable destructive data operations in production
ENABLE_DB_RESET=false
ENABLE_WIPE_MATTERS_AND_SETTINGS=false
